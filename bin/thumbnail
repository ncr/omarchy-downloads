#!/usr/bin/env python3
"""One local video thumbnail; keyed by file version, generated off the UI thread."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def thumbnail(path):
    source = Path(path)
    if not source.is_absolute() or not source.is_file():
        return {}
    stat = source.stat()
    key = hashlib.sha256((str(source) + ":" + str(stat.st_mtime_ns) + ":" + str(stat.st_size)).encode()).hexdigest()
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "omarchy-downloads" / "thumbnails"
    cache.mkdir(parents=True, exist_ok=True)
    target = cache / (key + ".jpg")
    metadata = cache / (key + ".json")
    if target.exists() and metadata.exists():
        return json.loads(metadata.read_text())
    duration = ""
    try:
        probe = subprocess.run(["ffprobe", "-v", "error", "-protocol_whitelist", "file,pipe", "-show_entries", "format=duration", "-of", "json", str(source)], capture_output=True, text=True, timeout=5, check=True)
        seconds = int(float(json.loads(probe.stdout).get("format", {}).get("duration", 0)))
        duration = (str(seconds // 3600) + ":" + str(seconds // 60 % 60).zfill(2) + ":" + str(seconds % 60).zfill(2)) if seconds >= 3600 else str(seconds // 60) + ":" + str(seconds % 60).zfill(2)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    fd, temporary = tempfile.mkstemp(suffix=".jpg", dir=cache)
    os.close(fd)
    try:
        subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe", "-threads", "1", "-i", str(source), "-frames:v", "1", "-vf", "scale=192:108:force_original_aspect_ratio=decrease", "-threads", "1", "-y", temporary], capture_output=True, timeout=10, check=True)
        if not Path(temporary).stat().st_size:
            return {}
        os.replace(temporary, target)
        result = {"thumbnail": target.as_uri(), "duration": duration}
        metadata.write_text(json.dumps(result))
        # Keep the plugin's private cache bounded (image + metadata per entry).
        entries = sorted(cache.glob("*.jpg"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in entries[256:]:
            old.unlink(missing_ok=True)
            old.with_suffix(".json").unlink(missing_ok=True)
        return result
    finally:
        Path(temporary).unlink(missing_ok=True)


try:
    print(json.dumps(thumbnail(sys.argv[1])))
except (OSError, ValueError, IndexError, subprocess.SubprocessError):
    print("{}")
