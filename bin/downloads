#!/usr/bin/env python3
"""Bounded directory listings for the recent-files panel (no shell evaluation)."""
import json
import os
from pathlib import Path
import sys

SCAN_CAP = 5000
ROW_CAP = 200
IMAGES = {"png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "avif", "heic", "ico", "tif", "tiff"}
VIDEOS = {"mp4", "mkv", "mov", "avi", "webm", "m4v", "mpg", "mpeg", "wmv"}
PARTIAL = {"crdownload", "part", "partial", "download", "tmp", "opdownload"}


def active_recording():
    """Omarchy keeps the output path until its recorder has finished saving."""
    try:
        return Path("/tmp/omarchy-screenrecord-filename").read_text().strip()
    except OSError:
        return ""


def listing(directory, kind="downloads"):
    if not os.path.isabs(directory) or not os.path.isdir(directory):
        return {"ok": False, "error": "Folder unavailable", "files": []}
    rows = []
    scanned = 0
    truncated = False
    recording = active_recording()
    with os.scandir(directory) as entries:
        for entry in entries:
            if scanned >= SCAN_CAP:
                truncated = True
                break
            scanned += 1
            if entry.name.startswith("."):
                continue
            suffix = entry.name.rsplit(".", 1)[-1].lower()
            try:
                is_dir = entry.is_dir(follow_symlinks=False)
                if not is_dir and not entry.is_file(follow_symlinks=False):
                    continue
                category = "images" if suffix in IMAGES else "videos" if suffix in VIDEOS else "other"
                if kind != "downloads" and (is_dir or category != kind):
                    continue
                if not is_dir and (suffix in PARTIAL or entry.path == recording):
                    continue
                stat = entry.stat(follow_symlinks=False)
                if not is_dir and category in {"images", "videos"} and stat.st_size == 0:
                    continue
            except OSError:
                continue
            rows.append({"name": entry.name, "path": entry.path,
                         "size": stat.st_size, "isDir": is_dir,
                         "modified": int(stat.st_mtime * 1000),
                         "version": str(stat.st_mtime_ns) + ":" + str(stat.st_size),
                         "category": "other" if is_dir else category,
                         "source": kind})
    rows.sort(key=lambda row: (-row["modified"], row["path"]))
    # Keep a separate allowance for each category in Downloads: recent images
    # must not disappear from their filter behind 200 newer archives.
    counts = {}
    kept = []
    omitted = []
    for row in rows:
        category = row["category"]
        counts[category] = counts.get(category, 0) + 1
        if counts[category] <= ROW_CAP:
            kept.append(row)
        else:
            # Retain only the fields needed to filter and deduplicate the
            # overflow count, including when files age out between scans.
            omitted.append({key: row[key] for key in ("path", "modified", "category", "source")}
                           | {"omitted": True})
    return {"ok": True, "files": kept, "omitted": omitted,
            "scanned": scanned, "truncated": truncated}


def main():
    try:
        cmd, directory, *args = sys.argv[1:]
        if cmd == "list":
            result = listing(directory, args[0] if args else "downloads")
        elif cmd == "probe":
            with os.scandir(directory) as entries:
                count = sum(1 for _, _entry in zip(range(2001), entries))
            result = {"ok": True, "entries": min(count, 2000), "over": count > 2000}
        else:
            raise ValueError("usage: downloads list|probe DIR [downloads|images|videos]")
    except (OSError, ValueError) as exc:
        result = {"ok": False, "error": str(exc), "files": []}
    print(json.dumps(result, ensure_ascii=True))


if __name__ == "__main__":
    main()
