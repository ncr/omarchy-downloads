#!/usr/bin/env python3
"""A cached, darkened average colour; decoding stays outside the shell."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import unquote, urlparse

try:
    uri = urlparse(sys.argv[1])
    if uri.scheme != "file" or uri.netloc not in ("", "localhost"):
        raise ValueError("local images only")
    path = Path(unquote(uri.path))
    stat = path.stat()
    key = hashlib.sha256((str(path) + str(stat.st_mtime_ns) + str(stat.st_size)).encode()).hexdigest()
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "omarchy-downloads" / "colors"
    cache.mkdir(parents=True, exist_ok=True)
    target = cache / (key + ".json")
    if target.exists():
        result = json.loads(target.read_text())
    else:
        data = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "file,pipe", "-threads", "1", "-i", str(path), "-frames:v", "1", "-vf", "scale=1:1:flags=area", "-threads", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "pipe:1"], capture_output=True, timeout=3, check=True).stdout
        if len(data) != 3:
            raise ValueError("invalid colour sample")
        result = {"color": "#" + "".join(f"{round(c * 0.28):02x}" for c in data)}
        temporary = target.with_suffix(f".{os.getpid()}.tmp")
        temporary.write_text(json.dumps(result))
        temporary.replace(target)
        entries = sorted(cache.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in entries[256:]:
            old.unlink(missing_ok=True)
    print(json.dumps(result))
except (OSError, ValueError, IndexError, subprocess.SubprocessError):
    print("{}")
